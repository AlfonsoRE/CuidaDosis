@startuml
title Despliegue - prototipo académico y operación remota
skinparam shadowing false
skinparam defaultFontSize 26
node "Teléfono del paciente" as T1 {
  artifact "CuidaDosis APK" as A1
}
node "Teléfono del cuidador\n(cualquier red: datos o Wi-Fi)" as T2 {
  artifact "CuidaDosis APK" as A2
}
node "Prototipo académico: XAMPP en red local" as S {
  artifact "api/ PHP 8" as PHP
  database "MariaDB 10.4" as DB
}
node "Operación remota: hosting con dominio y HTTPS" as H {
  artifact "api/ PHP 8.2" as PHP2
  database "MariaDB 11.4" as DB2
}
A1 --> PHP : HTTP en LAN
A1 --> PHP2 : HTTPS
A2 --> PHP2 : HTTPS
PHP --> DB : PDO
PHP2 --> DB2 : PDO
note bottom of H : Uso real exige respaldos probados, monitoreo, disponibilidad definida,\npolítica de datos personales y push (Tabla VIII).
@enduml
