# Único punto de entrada web de la API
Require all granted
Options -Indexes

# Bloquea archivos ocultos (.env, .htaccess, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On
# Las reglas son relativas a esta carpeta: funcionan igual en /CuidaDosis/api/public/ (XAMPP)
# y en una subcarpeta del hosting como /cuidadosis/api/. Solo si el hosting usa alias
# y las rutas dan 404, agrega: RewriteBase /cuidadosis/api/

# Pasa el encabezado Authorization a PHP
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Todo lo que no sea un archivo existente va a index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
