# Único punto de entrada web de la API
Require all granted
Options -Indexes

# Bloquea archivos ocultos (.env, .htaccess, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On

# Pasa el encabezado Authorization a PHP
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Todo lo que no sea un archivo existente va a index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
