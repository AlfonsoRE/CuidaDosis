# Plantilla de configuración de la API para un hosting.
# En el servidor se copia como .env en la carpeta de la cuenta, FUERA de public_html
# (al mismo nivel que src/ y config/). Nunca se sube al repositorio con valores reales.

# Datos que da el hosting para la base de datos
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Vigencia del token de sesión, en horas (720 = 30 días)
TOKEN_TTL_HOURS=720

# En un servidor público siempre false
APP_DEBUG=false
