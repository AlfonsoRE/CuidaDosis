# Plantilla de configuración de la API.
# Copia este archivo a api/.env y llena los valores locales.
# api/.env nunca se sube al repositorio.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cuidadosis
DB_USER=
DB_PASS=

# Vigencia del token de sesión, en horas
TOKEN_TTL_HOURS=720

# true solo en desarrollo local
APP_DEBUG=false

# Prefijo de la URL donde se sirve la API. Vacío = se deduce de la ubicación de index.php
# (en XAMPP es /CuidaDosis/api/public). Solo hace falta si el hosting reescribe rutas.
APP_BASE_PATH=
