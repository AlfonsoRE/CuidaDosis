<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reenviar confirmaciones hechas sin red cuando vuelve la conexión (Fase 6) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+: necesario para llegar a la API en la red local (10.0.2.2 o la IP de la PC) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Aviso 5 minutos antes de cada toma (Fase 5) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Alarma de la toma (v1.1): vibración y pantalla de alarma sobre el bloqueo -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".CuidaDosisApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CuidaDosis">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CuidaDosis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de la alarma de la toma (RF-06, v1.1): se abre sobre la pantalla de bloqueo -->
        <activity
            android:name=".reminders.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="mx.cuidadosis.app.alarma"
            android:theme="@style/Theme.CuidaDosis" />

        <!-- Alarmas de los avisos (solo la app las programa) -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Alarma del cuidador a T + 30 (RF-18) -->
        <receiver
            android:name=".reminders.CaregiverAlarmReceiver"
            android:exported="false" />

        <!-- Botones "Tomado" y "Posponer" de la notificación, y corte de la alarma a los 2 minutos -->
        <receiver
            android:name=".reminders.SnoozeReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.TakeReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.RingLimitReceiver"
            android:exported="false" />

        <!-- Reprograma tras reiniciar, actualizar la app o cambiar la hora; solo acciones protegidas del sistema -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
